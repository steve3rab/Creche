{
  "name": "filoustics-secretariat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts --dev",
    "start": "node dist-server/server/index.js",
    "build": "vue-tsc --noEmit && vite build && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:visual:update": "npm run build && playwright test --update-snapshots=all",
    "demo": "tsx scripts/demo.ts",
    "format": "prettier --write src server scripts tests *.ts *.json README.md"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-vue-next": "npm:@lucide/vue@^1.42.0",
    "playwright": "^1.56.0",
    "sanitize-html": "^2.17.7",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.1",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "2.4.6",
    "jsdom": "^27.0.0",
    "pdfjs-dist": "^6.3.289",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "overrides": {
    "glob": "^13.0.0"
  },
  "engines": {
    "node": ">=24.13.0"
  }
}
